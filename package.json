{
  "name": "hong-student-sign-in",
  "version": "1.1.2",
  "description": "机房签到系统基础框架",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:archive": "node --experimental-strip-types --test tests/attendance-archive.test.mjs",
    "test:terminals": "node --experimental-strip-types --test tests/terminal-seats.test.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "preview:student": "node tools/preview-student.mjs",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:win:teacher": "npm run build && electron-builder --win --config electron-builder.teacher.yml",
    "build:win:student": "npm run build && electron-builder --win --config electron-builder.student.yml",
    "build:win:teacher:dir": "npm run build && electron-builder --dir --config electron-builder.teacher.yml",
    "build:win:student:dir": "npm run build && electron-builder --dir --config electron-builder.student.yml",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lucide/vue": "^1.64.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "pinia": "^4.1.0",
    "tailwind-merge": "^3.7.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "unocss": "^66.12.0",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
